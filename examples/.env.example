# DeepX SDK examples configuration
# Usage: cp examples/.env.example examples/.env, then fill in the private key.
# (examples/.env is git-ignored and will not be committed;
#  real environment variables take precedence over this file)

# ---- Required ----
# Private key of the EOA that owns the subaccount (the address must be
# activated on-chain and have quota)
PRIVATE_KEY=0x...
# Subaccount address (needs USDC collateral); may stay empty for the
# first run of onboarding.py
SUBACCOUNT=0x...
# EOA wallet address (used by quota.py); derived from PRIVATE_KEY when empty
WALLET=

# ---- Endpoint overrides (SDK development only — users can ignore this) ----
# Examples connect to the DeepX network by default. SDK developers point
# these at the internal deployment (no network names involved):
SUBSTRATE_WS=
EVM_RPC_URL=
API_BASE_URL=
# bridge_evm.py only: BRIDGE_SRC_RPC / BRIDGE_SRC_CHAIN_ID / BRIDGE_SRC /
# SIGN_API_BASE

# ---- Order example parameters (sync_orders.py / async_orders.py / async_order_monitoring.py) ----
MARKET_ID=3              # perp market id (3 = ETH-USDC)
SIDE=buy                 # buy | sell
SIZE=1000000000000000    # base units (market 3 min order size is 1e15)
PRICE=1800000000         # price (1e6 precision, i.e. 1800.0); IOC only fills through the book
CLOID=                   # client order id [2^31-1, 2^32-2], single-use; empty = random each run
